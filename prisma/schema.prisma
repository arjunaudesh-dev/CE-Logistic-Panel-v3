// CE Logistic Panel — Prisma schema
// Dockyard ERP: Projects, Procurement, Stores, Rate Finder, Collection

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────── MODULE 2: PROJECTS ─────────────────────────
model Project {
  id            String   @id @default(cuid())
  name          String
  voteNumber    String
  voteAllocation Float   @default(0)
  committed     Float    @default(0)
  actualSpent   Float    @default(0)
  startDate     String?
  endDate       String?  // EDC (Estimated Date of Completion)
  department    String?  // kept for backward compat
  benefactor    String?  // replaces "Department" label
  reference     String?  // reference type (e.g. AOR, WorkOrder, Estimate)
  projectOfficer String?
  status        String   @default("Active") // Active | On Hold | Completed | Cancelled
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  files        ProjectFile[]
  allocations  Allocation[]
  estimates    Estimate[]
  earmarks     EarmarkedItem[]
}

model ProjectFile {
  id              String   @id @default(cuid())
  projectId       String
  prNumber        String
  itemCode        String
  itemName        String
  unit            String
  qty             Float    @default(0)
  unitPrice       Float    @default(0)
  fileCost        Float    @default(0)
  supplier        String?
  presentPosition String   @default("PR Raised") // see PRESENT_POSITIONS
  fileCategory    String   @default("General")
  createdBy       String?
  authorizedBy    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logs        FileLog[]

  @@index([projectId])
}

model FileLog {
  id          String   @id @default(cuid())
  fileId      String
  oldPosition String?
  newPosition String
  changedBy   String?
  comment     String?
  changedAt   DateTime @default(now())

  file ProjectFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
}

model Allocation {
  id            String   @id @default(cuid())
  projectId     String
  date          String
  description   String
  amount        Float    @default(0)
  type          String   @default("Commitment") // Commitment | Actual | Release
  authorizedBy  String?
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ───────────────────────── MODULE 3: PROCUREMENT ─────────────────────────
// Procurement files are stored independently so they can be queried across projects.
model ProcurementFile {
  id              String   @id @default(cuid())
  projectId       String?
  projectName     String?
  voteNumber      String?
  prNumber        String
  itemCode        String
  itemName        String
  unit            String
  qty             Float    @default(0)
  unitPrice       Float    @default(0)
  fileCost        Float    @default(0)
  supplier        String?
  presentPosition String   @default("PR Raised")
  fileCategory    String   @default("General")
  createdBy       String?
  authorizedBy    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  logs ProcurementLog[]

  @@index([presentPosition])
  @@index([supplier])
}

model ProcurementLog {
  id          String   @id @default(cuid())
  fileId      String
  oldPosition String?
  newPosition String
  changedBy   String?
  comment     String?
  changedAt   DateTime @default(now())

  file ProcurementFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
}

// ───────────────────────── ESTIMATES (Project Step 1 & 2) ─────────────────────────
model Estimate {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  status      String   @default("Draft") // Draft | Processed | Archived
  processedAt DateTime?
  createdAt   DateTime @default(now())

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   EstimateItem[]

  @@index([projectId])
}

model EstimateItem {
  id                 String   @id @default(cuid())
  estimateId         String
  srNo               Int      @default(1)
  itemName           String
  itemCode           String?  // matched item code from DB (AI)
  qty                Float    @default(0)
  unit               String   @default("NOS")
  estimateCost       Float    @default(0) // original estimate cost
  approxCost         Float    @default(0) // RC rate if RC else estimate cost
  isRC               Boolean  @default(false)
  rcNumber           String?  // RC year/number if in RC list
  rcRate             Float    @default(0)
  rcSupplier         String?
  lastPurchasePrice  Float    @default(0) // from DB previous purchases
  availableStock     Float    @default(0) // balance stock
  stockLocation      String?  // location if available
  nonMovingStock     Float    @default(0)
  status             String   @default("Pending") // Pending | Initiated
  prNumber           String?  // PR/GORF number after Initiate File
  fileNumber         String?  // file number with date
  fileId             String?  // link to created ProjectFile
  createdAt          DateTime @default(now())

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
}

// ───────────────────────── EARMARKED ITEMS (Stores) ─────────────────────────
model EarmarkedItem {
  id            String   @id @default(cuid())
  storeItemId   String?
  itemDescription String
  itemCode      String?
  projectId     String
  projectName   String
  qty           Float    @default(0)
  unit          String   @default("NOS")
  authority     String?  // authority who gave approval
  remarks       String?
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ───────────────────────── QC INSPECTION (Collection) ─────────────────────────
model QCInspection {
  id              String   @id @default(cuid())
  refType         String   // daily | partsupply | collection
  refId           String
  itemName        String
  supplier        String?
  qty             Float    @default(0)
  qcLevel         String   // Fail | Below Average | Satisfactory | Good | Excellent
  qcOfficer       String?
  qcOfficerDetails String?
  remarks         String?  // mandatory if Fail
  inspectedAt     DateTime @default(now())

  @@index([refType, refId])
}

// ───────────────────────── STAKEHOLDERS (Officers, Sailors, Suppliers) ─────────────────────────
model Stakeholder {
  id            String   @id @default(cuid())
  name          String
  rankOrRate    String?  // rank for officers (e.g. Cdr, Lt), rate for sailors
  svcNumber     String?  // SVC number
  appointment   String?  // CSLOG, CLOGD, ASO(E), APO(E), AAPO(PT), CCED(E), CCEO(E), SCE(M), SCE(P&P)
  department    String   @default("CSLOG") // CSLOG | CE
  officeNumber  String?
  telephone     String?
  whatsapp      String?
  email         String?
  availability  String   @default("Available") // Available | On Leave | Busy | Off Duty
  role          String   @default("Officer") // Officer | Sailor
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([department])
  @@index([appointment])
}

model Supplier {
  id              String   @id @default(cuid())
  name            String   @unique
  contactPerson   String?
  telephone       String?
  whatsapp        String?
  email           String?
  address         String?
  contractDetails String?  // general contract info / RC validity etc.
  registrationNo  String?
  vatNo           String?
  bankDetails     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contacts    SupplierContact[]
  nominations SupplierNomination[]
  ratings     SupplierRating[]
}

model SupplierContact {
  id          String   @id @default(cuid())
  supplierId  String
  name        String
  designation String?
  telephone   String?
  whatsapp    String?
  email       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model SupplierNomination {
  id         String   @id @default(cuid())
  supplierId String
  itemCode   String?
  itemName   String
  category   String   @default("General")
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model SupplierRating {
  id               String   @id @default(cuid())
  supplierId       String
  qciScore         Float    @default(0)  // 1-5, from QC inspections
  loyalty          Float    @default(0)  // 1-5
  professionalism  Float    @default(0)  // 1-5
  activeEngagement Float    @default(0)  // 1-5
  values           Float    @default(0)  // 1-5
  overallScore     Float    @default(0)  // computed average
  remarks          String?
  ratedBy          String?
  ratedAt          DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

// ───────────────────────── ITEM MASTER (consolidated catalogue) ─────────────────────────
model ItemMaster {
  id            String   @id @default(cuid())
  canonicalCode String   @unique  // the concluded single item code
  description   String
  category      String   @default("General")
  unit          String   @default("NOS")
  alternateCodes String?  // comma-separated duplicate/alternate codes consolidated
  alternateNames String?  // comma-separated duplicate names
  status        String   @default("Active") // Active | Merged | Discontinued
  mergedInto    String?  // canonical code this was merged into
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([status])
}

// ───────────────────────── MODULE 4: STORES ─────────────────────────
model StoreZone {
  id                String   @id @default(cuid())
  name              String   @unique // Zone A, Ready-Use Stores, etc.
  type              String   @default("Zone") // Zone | Ready-Use | Balance | Project
  totalValue        Float    @default(0)
  itemCount         Int      @default(0)
  lowStockCount     Int      @default(0)
  recentReceipts    Int      @default(0)
  pendingCollection Int      @default(0)
  nonMovingCount    Int      @default(0)
  createdAt         DateTime @default(now())
}

model StoreItem {
  id            String   @id @default(cuid())
  zoneId        String?
  zoneName      String
  description   String
  category      String   @default("General")
  unit          String   @default("NOS")
  qty           Float    @default(0)
  unitCost      Float    @default(0)
  totalCost     Float    @default(0)
  location      String?
  minStock      Float    @default(0)
  maxStock      Float    @default(0)
  lastMovement  String?
  supplier      String?
  itemCode      String?
  ilmsCode      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([zoneName])
  @@index([category])
}

// ───────────────────────── MODULE 5: RATE FINDER ─────────────────────────
model RateContract {
  id          String   @id @default(cuid())
  itemCode    String
  description String
  unit        String
  rcPrice     Float    @default(0)
  supplier    String?
  rcYear      String
  validFrom   String?
  validUntil  String?
  category    String   @default("General")
  uploadedAt  DateTime @default(now())

  @@index([rcYear])
  @@index([category])
}

model DiscontinuedItem {
  id               String   @id @default(cuid())
  itemCode         String
  description      String
  unit             String
  lastRCPrice      Float    @default(0)
  lastRCYear       String?
  discontinuedDate String?
  reason           String?
  alternatives     String?  // comma separated item codes/names
  createdAt        DateTime @default(now())
}

// ───────────────────────── MODULE 6: COLLECTION ─────────────────────────
model CollectionItem {
  id          String   @id @default(cuid())
  name        String
  expectedQty Float    @default(0)
  status      String   @default("Pending") // Pending | In Progress | Collected
  dueDate     String?
  supplier    String?
  createdAt   DateTime @default(now())
}

model PartSupplyOrder {
  id              String   @id @default(cuid())
  itemName        String
  orderedQty      Float    @default(0)
  receivedQty     Float    @default(0)
  balance         Float    @default(0)
  startDate       String?
  expectedEndDate String?
  status          String   @default("Active") // Active | Completed
  supplier        String?
  createdAt       DateTime @default(now())

  entries PartSupplyEntry[]
}

model PartSupplyEntry {
  id                 String  @id @default(cuid())
  orderId            String
  srNo               Int     @default(1)
  date               String
  vehicleNumber      String?
  qty                Float   @default(0)
  qcCheckedBy        String?
  sailorCount        Int     @default(0)
  driverName         String?
  driverLicense      String?
  driverPhone        String?
  cumulativeBalance  Float   @default(0)
  createdAt          DateTime @default(now())

  order PartSupplyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model DailyCollection {
  id           String   @id @default(cuid())
  date         String
  itemName     String
  qty          Float    @default(0)
  receivedFrom String?
  recordedBy   String?
  recordedAt   DateTime @default(now())

  @@index([date])
}
